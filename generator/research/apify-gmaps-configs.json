{
  "_doc": "Apify Google Maps Scraper (compass/crawler-google-places) configs for the Irvine local-pack study. Run in order. Phase 2 is where the SEO signal lives — reviewsTags/peopleAlsoSearch/questionsAndAnswers only appear when scrapePlaceDetailPage is true.",
  "_actor": "compass/crawler-google-places",
  "phase1_discovery": {
    "_purpose": "Who is in the competitive set. Cheap, no detail pages. Establishes the roster + review-count bar.",
    "_est_cost_usd": 0.96,
    "input": {
      "searchStringsArray": [
        "house painters",
        "exterior painting",
        "painting contractor",
        "cabinet painting"
      ],
      "locationQuery": "Irvine, California",
      "countryCode": "us",
      "maxCrawledPlacesPerSearch": 60,
      "language": "en",
      "skipClosedPlaces": true,
      "scrapePlaceDetailPage": false
    }
  },
  "phase2_deep_profile": {
    "_purpose": "The real payload. Detail pages unlock reviewsTags (Googles own keyword clusters from reviews — these power local-pack justifications), peopleAlsoSearch (Googles competitive graph), questionsAndAnswers, ownerUpdates (GBP posting cadence), reviewsDistribution, imageCategories.",
    "_est_cost_usd": 1.72,
    "_note": "Replace placeIds with the top ~20 from phase 1. Using placeIds avoids re-paying for discovery.",
    "input": {
      "placeIds": [
        "<TOP_20_FROM_PHASE_1>"
      ],
      "language": "en",
      "scrapePlaceDetailPage": true,
      "maxReviews": 150,
      "reviewsSort": "newest",
      "reviewsStartDate": "18 months",
      "scrapeReviewsPersonalData": false,
      "maxQuestions": 999,
      "includeWebResults": true,
      "maxImages": 0
    }
  },
  "phase3_geo_grid": {
