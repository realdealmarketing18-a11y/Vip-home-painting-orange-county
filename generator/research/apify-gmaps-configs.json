{
  "_doc": "LEAN design: 2 runs build one reusable review corpus. Collection happens rarely; extraction happens every time a page is built. Grid is deferred — it is optimization, not foundation.",
  "_actor": "compass/crawler-google-places",
  "_principle": "Scrape once, mine ten times. ~2,500 real OC homeowner reviews feed FAQs, problem/solution, proof points, Shorts scripts, GBP posts, review-request coaching, and ad copy.",
  "run_A_anaheim": {
    "_purpose": "THE WINNABLE PACK. Your pin is here. Review counts and categories here translate into action you can take this month.",
    "_feeds": "local_pack for the Anaheim page + GBP category/review strategy",
    "_est_cost_usd": 1.43,
    "input": {
      "searchStringsArray": [
        "house painters"
      ],
      "locationQuery": "Anaheim, California",
      "countryCode": "us",
      "maxCrawledPlacesPerSearch": 25,
      "language": "en",
      "skipClosedPlaces": true,
      "scrapePlaceDetailPage": true,
      "maxReviews": 100,
      "reviewsSort": "newest",
      "reviewsStartDate": "18 months",
      "scrapeReviewsPersonalData": false,
      "maxQuestions": 999,
      "includeWebResults": true,
      "maxImages": 0
    }
  },
  "run_B_irvine": {
